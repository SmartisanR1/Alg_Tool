<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CryptoKit</RootNamespace>
    <AssemblyName>CryptoKit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 非打包（unpackaged）+ 框架依赖 WinAppSDK：产物小，运行时一次安装、免 MSIX。
         引导器自动初始化（Bootstrap.TryInitialize）定位已安装的 Windows App SDK 运行时。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <!-- 只保留中/英卫星程序集，去掉其余语言包 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK：WinUI3 + Mica/Acrylic 后层 + Fluent 2 主题资源 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用图标：嵌入 exe（ApplicationIcon 已在上面声明），并复制到输出目录供运行时 SetIcon -->
    <Content Include="Assets\appicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CryptoKit</RootNamespace>
    <AssemblyName>CryptoKit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 便携发布：不安装、不依赖目标机器已有的 .NET 或 Windows App SDK。
         采用「目录级 xcopy 部署」：Windows App SDK 原生运行时以独立 DLL 置于 exe
         同级目录。不要启用 PublishSingleFile——自包含 + 单文件模式存在已知 bug，
         应用启动后不显示窗口（microsoft/WindowsAppSDK#6248、#3718），且官方
         自包含部署指南明确要求 WinUI3 的原生运行时必须保留为独立文件。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- MRT 资源统一命名为 resources.pri，规避单文件/exe 改名场景下资源查找失败的已知问题 -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 只保留中/英卫星程序集，去掉其余语言包 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK：WinUI3 + Mica/Acrylic 后层 + Fluent 2 主题资源 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

</Project>

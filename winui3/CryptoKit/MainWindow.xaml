<Window
    x:Class="CryptoKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（延伸到标题栏区域，让 Mica 覆盖整窗） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE950;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="CryptoKit" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 中间为标题栏拖拽区（SetTitleBar 自动处理） -->

            <Button x:Name="ThemeButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Click="OnThemeClick"
                    ToolTipService.ToolTip="切换主题（跟随系统 / 浅色 / 深色）">
                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- 主导航 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home"/>
                <NavigationViewItemSeparator/>

                <NavigationViewItemHeader Content="联调"/>
                <NavigationViewItem Content="报文收发" Tag="packet"/>
                <NavigationViewItem Content="TLS / TLCP" Tag="tls"/>

                <NavigationViewItemHeader Content="对称"/>
                <NavigationViewItem Content="对称算法" Tag="symmetric"/>
                <NavigationViewItem Content="金融算法" Tag="finance"/>

                <NavigationViewItemHeader Content="非对称"/>
                <NavigationViewItem Content="公钥算法" Tag="asymmetric"/>
                <NavigationViewItem Content="证书管理" Tag="cert"/>
                <NavigationViewItem Content="后量子" Tag="pqc"/>

                <NavigationViewItemHeader Content="摘要"/>
                <NavigationViewItem Content="哈希摘要" Tag="hash"/>
                <NavigationViewItem Content="MAC / KDF" Tag="mac"/>

                <NavigationViewItemHeader Content="工具"/>
                <NavigationViewItem Content="转换工具" Tag="tools"/>
                <NavigationViewItem Content="大数运算" Tag="bigint"/>
                <NavigationViewItem Content="文件加密" Tag="file"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>

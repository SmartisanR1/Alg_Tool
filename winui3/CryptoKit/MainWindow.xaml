<Window
    x:Class="CryptoKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（延伸到标题栏区域，让 Mica 覆盖整窗） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="White" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="0">
                    <TextBlock Text="CryptoKit" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="本地密码工具箱" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 中间为标题栏拖拽区（SetTitleBar 自动处理） -->

            <Button x:Name="ThemeButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Click="OnThemeClick"
                    ToolTipService.ToolTip="切换主题（跟随系统 / 浅色 / 深色）">
                <FontIcon Glyph="&#xE706;" FontFamily="Segoe MDL2 Assets" Width="16" Height="16"/>
            </Button>
        </Grid>

        <!-- 主导航 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            IsPaneToggleButtonVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <!-- 图标一律用 FontIcon + MDL2 字形码，不要用 Icon="字符串"（XAML 的
                     IconElement 字符串转换在部分 Symbol 枚举上会抛 XamlParseException，
                     导致主窗口初始化失败） -->
                <NavigationViewItem Content="工作台" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="摘要 / MAC" Tag="hash">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="密钥工具" Tag="keys">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="对称算法" Tag="symmetric">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="公钥 / 国密" Tag="asymmetric">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB95;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="后量子" Tag="pqc">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE909;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="编码转换" Tag="tools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="协议联调" Tag="packet">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>

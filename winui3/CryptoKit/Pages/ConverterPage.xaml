<Page
    x:Class="CryptoKit.Pages.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="40,32,40,48" Spacing="20" MaxWidth="1440" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="编码转换" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="文本、Hex 与 Base64 的本地转换，适合整理待计算的数据。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <TabView IsAddTabButtonVisible="False">
                <TabViewItem Header="文本 / Hex" IsClosable="False">
                    <Grid Padding="4,20,4,4" ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="输入" FontWeight="SemiBold"/>
                            <TextBox x:Name="InputBox" Height="240" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="输入文本或 Hex…"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                            <Button Content="转为 Hex →" Click="OnTextToHexClick"/>
                            <Button Content="← 转为文本" Click="OnHexToTextClick"/>
                            <Button Content="清空" Click="OnClearClick"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="10">
                            <TextBlock Text="结果" FontWeight="SemiBold"/>
                            <TextBox x:Name="ResultBox" Height="240" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" PlaceholderText="转换结果将显示在这里"/>
                        </StackPanel>
                    </Grid>
                </TabViewItem>
            </TabView>
        </StackPanel>
    </ScrollViewer>
</Page>

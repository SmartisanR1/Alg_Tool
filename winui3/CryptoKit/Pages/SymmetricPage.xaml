<Page
    x:Class="CryptoKit.Pages.SymmetricPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="40,32,40,48" Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="对称算法" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="使用 Hex 格式的密钥、初始向量和数据完成本地 AES 或 SM4 计算。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <TabView IsAddTabButtonVisible="False">
                <TabViewItem Header="加密 / 解密" IsClosable="False">
                    <Grid Padding="4,20,4,4" ColumnSpacing="28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="12">
                            <TextBlock Text="算法" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AlgorithmBox" SelectedIndex="0">
                                <ComboBoxItem Content="AES-256 / CBC" Tag="AES"/>
                                <ComboBoxItem Content="SM4 / CBC" Tag="SM4"/>
                            </ComboBox>
                            <TextBlock Text="密钥（Hex）" FontWeight="SemiBold"/>
                            <TextBox x:Name="KeyBox" PlaceholderText="AES: 32 / 48 / 64 位 Hex；SM4: 32 位 Hex"/>
                            <TextBlock Text="初始向量 IV（Hex，可留空自动生成）" FontWeight="SemiBold"/>
                            <TextBox x:Name="IvBox" PlaceholderText="32 位 Hex"/>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="CBC 模式"
                                     Message="加密时若不填 IV，引擎会生成随机 IV 并在结果下方返回。"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock Text="数据（Hex）" FontWeight="SemiBold"/>
                            <TextBox x:Name="DataBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                     PlaceholderText="例如：00112233445566778899AABBCCDDEEFF"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="EncryptButton" Content="加密" Style="{StaticResource AccentButtonStyle}" Click="OnEncryptClick"/>
                                <Button x:Name="DecryptButton" Content="解密" Click="OnDecryptClick"/>
                                <Button Content="清空" Click="OnClearClick"/>
                            </StackPanel>
                            <TextBlock Text="结果（Hex）" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBox x:Name="ResultBox" Height="130" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" PlaceholderText="计算结果将显示在这里"/>
                            <TextBlock x:Name="ExtraText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </TabViewItem>
            </TabView>
        </StackPanel>
    </ScrollViewer>
</Page>
